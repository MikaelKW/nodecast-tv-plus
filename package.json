{
    "name": "nodecast-tv-plus",
    "version": "2.6.0",
    "description": "NodeCast TV Plus - Modern IPTV Player",
    "license": "GPL-3.0-only",
    "main": "server/index.js",
    "scripts": {
        "start": "node server/index.js",
        "dev": "node --watch server/index.js",
        "check": "node scripts/check-syntax.js",
        "release:check": "node scripts/release-check.js",
        "test:e2e": "playwright test",
        "test:e2e:mobile": "playwright test --config=playwright.mobile.config.js",
        "test:e2e:subpath": "playwright test --config=playwright.subpath.config.js",
        "test:hardware": "node scripts/hw-detect-test.js",
        "test:oidc": "node scripts/oidc-discovery-test.js",
        "test:xtream": "node scripts/xtream-epg-collision-test.js",
        "test:xtream-api": "node scripts/xtream-api-compatibility-test.js",
        "test:variants": "node scripts/channel-variant-test.js",
        "test:catalogue-resilience": "node scripts/channel-catalogue-resilience-test.js",
        "test:catalogue-search": "node scripts/catalogue-search-test.js",
        "test:transcode": "node scripts/transcode-test.js",
        "test:subtitle": "node scripts/subtitle-test.js",
        "test:vod-duration": "node scripts/vod-duration-test.js",
        "test:real-world": "node scripts/real-world-m3u-test.js",
        "test:migration": "node scripts/migration-test.js",
        "test:auth": "node scripts/auth-username-test.js",
        "test:health": "node scripts/health-check-test.js",
        "test:proxy": "node scripts/proxy-stream-test.js",
        "test:remux": "node scripts/remux-test.js",
        "test:xtream-fallback": "node scripts/xtream-format-fallback-test.js",
        "test:totp": "node scripts/totp-auth-test.js",
        "test:session-isolation": "node scripts/session-cookie-isolation-test.js",
        "test:performance": "node scripts/large-provider-performance-test.js",
        "test:favorite-channels": "node scripts/favorite-channels-test.js",
        "benchmark:catalogue": "node --expose-gc scripts/large-catalogue-benchmark.js",
        "test:content-visibility": "node scripts/content-visibility-test.js",
        "test:ffmpeg-binary": "node scripts/ffmpeg-binary-test.js",
        "test:content-group-state": "node scripts/content-group-state-test.js",
        "test:xmltv": "node scripts/xmltv-timestamp-test.js",
        "test:security": "node scripts/security-test.js",
        "test:resource-controls": "node scripts/resource-controls-test.js",
        "test:updates": "node scripts/release-update-test.js",
        "test:smoke": "node scripts/smoke-test.js",
        "test": "npm run check && npm run release:check && npm run test:security && npm run test:resource-controls && npm run test:updates && npm run test:auth && npm run test:health && npm run test:proxy && npm run test:ffmpeg-binary && npm run test:remux && npm run test:xtream-fallback && npm run test:xtream-api && npm run test:totp && npm run test:session-isolation && npm run test:performance && npm run test:favorite-channels && npm run test:content-visibility && npm run test:content-group-state && npm run test:xmltv && npm run test:hardware && npm run test:oidc && npm run test:xtream && npm run test:variants && npm run test:catalogue-resilience && npm run test:catalogue-search && npm run test:transcode && npm run test:subtitle && npm run test:vod-duration && npm run test:smoke"
    },
    "dependencies": {
        "@ffprobe-installer/ffprobe": "^2.1.2",
        "bcryptjs": "^3.0.3",
        "better-sqlite3": "^13.0.3",
        "compression": "^1.8.1",
        "dotenv": "^17.2.3",
        "express": "^4.22.2",
        "express-rate-limit": "^8.6.1",
        "express-session": "^1.18.2",
        "jsonwebtoken": "^9.0.3",
        "otpauth": "^9.5.1",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "passport-local": "^1.0.0",
        "passport-openidconnect": "^0.1.2",
        "qrcode": "^1.5.4",
        "sax": "^1.4.3",
        "xml2js": "^0.6.2"
    },
    "optionalDependencies": {
        "ffmpeg-static": "^5.3.0"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.1"
    }
}
